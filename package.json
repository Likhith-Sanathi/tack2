{
  "name": "tack",
  "version": "0.1.0",
  "description": "A terminal coding agent powered by OpenRouter",
  "type": "module",
  "bin": {
    "tack": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "sandbox-check": "node dist/sandbox-check.js"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@vscode/ripgrep": "^1.18.0",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "ignore": "^7.0.12",
    "ink": "^8.0.0",
    "marked": "^18.0.14",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
